# Integrações (todas opcionais). Sem valor = adaptador simulado.
# Credenciais NUNCA aqui: ficam no backend de integração.
VITE_ENTRA_TENANT=
VITE_SHAREPOINT_SITE=
VITE_FEEDBACK_URL=
VITE_CHAMADOS_API=
VITE_TEAMS_TENANT=
VITE_MAIL_SENDER=
# Backend que valida conexões (GET /integracoes/<id>/status → { ok, detalhe })
VITE_INTEGRATION_API=

# Consultas reais somente leitura. Use apenas chaves publishable/anon públicas.
# O núcleo deve fornecer window.horizonAuth.getAccessToken() com o JWT do usuário.
# Nunca use service_role no navegador.
VITE_SUPABASE_INVENTARIO_URL=
VITE_SUPABASE_INVENTARIO_PUBLISHABLE_KEY=
VITE_INVENTARIO_READ_VIEW=horizon_inventory_read

VITE_SUPABASE_VIAGENS_URL=
VITE_SUPABASE_VIAGENS_PUBLISHABLE_KEY=
VITE_VIAGENS_READ_VIEW=horizon_travel_read

VITE_SUPABASE_REVERSO_URL=
VITE_SUPABASE_REVERSO_PUBLISHABLE_KEY=
VITE_REVERSO_READ_VIEW=horizon_reverse_read

# Backend do The One System (server-side only; never prefix these values with VITE_).
PORT=4174
HORIZON_DATA_DIR=.horizon-data
HORIZON_API_TARGET=http://127.0.0.1:4174
HORIZON_GIT_ALLOWED_HOSTS=github.com
HORIZON_PLUGIN_CONNECTION_ALLOWED_HOSTS=
HORIZON_ADMIN_TOKEN=
HORIZON_SESSION_SECRET=
# Em produção o emissor confiável deve assinar tokens do The One System fora do navegador.
# O modo local habilita sessão de persona apenas pelo processo npm run dev.
HORIZON_DEV_SESSIONS=0
# Private Git credentials use the server's Git credential helper or SSH agent/key.
